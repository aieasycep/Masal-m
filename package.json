{
  "name": "masalim",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:mobile": "pnpm --filter @masalim/mobile dev",
    "dev:api": "pnpm --filter @masalim/api dev",
    "dev:admin": "pnpm --filter @masalim/admin dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @masalim/api test:integration",
    "db:migrate": "pnpm --filter @masalim/database db:migrate",
    "db:migrate:deploy": "pnpm --filter @masalim/database db:migrate:deploy",
    "db:generate": "pnpm --filter @masalim/database db:generate",
    "db:seed": "pnpm --filter @masalim/database db:seed",
    "db:studio": "pnpm --filter @masalim/database db:studio",
    "i18n:check": "pnpm --filter @masalim/localization check-parity",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3"
  },
  "pnpm": {
    "overrides": {
      "zod": "^3.25.76"
    },
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp",
      "ffmpeg-static",
      "unrs-resolver"
    ]
  }
}
