# ── Core infrastructure ──────────────────────────────────────────────────────
# docker compose up -d provides all three locally.
DATABASE_URL=postgresql://masalim:masalim@localhost:5432/masalim
REDIS_URL=redis://localhost:6379

# development | staging | production
NODE_ENV=development
API_PORT=3001
# Public URL of the API (used in payment callbacks and signed dev-storage URLs)
API_PUBLIC_URL=http://localhost:3001
# Comma-separated CORS allowlist for the admin panel
CORS_ORIGINS=http://localhost:3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=
# Apple Sign In (server-side identity token verification)
APPLE_BUNDLE_ID=com.masalim.app
# Google Sign In (web client ID used as the idToken audience)
GOOGLE_CLIENT_ID=

# ── Storage (s3 | local) ─────────────────────────────────────────────────────
# "local" stores files on disk and serves them from the API (dev only).
# "s3" works with AWS S3, Cloudflare R2 and MinIO (docker compose defaults below).
STORAGE_PROVIDER=s3
STORAGE_BUCKET=masalim-media
STORAGE_REGION=auto
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=masalim
STORAGE_SECRET_KEY=masalim-dev
STORAGE_FORCE_PATH_STYLE=true
SIGNED_URL_TTL_SECONDS=900
# Local provider only:
STORAGE_LOCAL_DIR=.local-storage

# ── AI providers (mock | anthropic | openai | elevenlabs) ────────────────────
# Every provider has a complete mock; production refuses mock providers at boot.
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=claude-opus-5

# mock | llm (Anthropic) | openai — llm/openai share AI_API_KEY
MODERATION_PROVIDER=mock
MODERATION_MODEL=claude-opus-5

TTS_PROVIDER=mock
TTS_API_KEY=
TTS_MODEL=eleven_multilingual_v2

VOICE_CLONE_PROVIDER=mock
VOICE_CLONE_API_KEY=

IMAGE_PROVIDER=mock
IMAGE_API_KEY=
IMAGE_MODEL=gpt-image-1

# Days to keep raw voice recordings after a clone is READY (0 = delete immediately)
VOICE_RAW_RETENTION_DAYS=0

# ── Payments & subscriptions (mock | iyzico / mock | revenuecat) ─────────────
PAYMENT_PROVIDER=mock
IYZICO_API_KEY=
IYZICO_SECRET=
# https://sandbox-api.iyzipay.com or https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

SUBSCRIPTION_PROVIDER=mock
# RevenueCat webhook authorization header value
REVENUECAT_WEBHOOK_SECRET=

PRINT_PROVIDER=mock

# ── Notifications ────────────────────────────────────────────────────────────
PUSH_PROVIDER=mock
EXPO_ACCESS_TOKEN=

# ── Mail (mock logs OTPs to console) ─────────────────────────────────────────
MAIL_PROVIDER=mock
MAIL_FROM=no-reply@masalim.app
SMTP_URL=

# ── Observability ────────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=debug

# ── App version gate ─────────────────────────────────────────────────────────
MIN_SUPPORTED_APP_VERSION=0.1.0
LATEST_APP_VERSION=0.1.0
IOS_STORE_URL=
ANDROID_STORE_URL=

# ── Seeds ────────────────────────────────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@masalim.local
SEED_ADMIN_PASSWORD=admin-dev-password-1

# ── Workers ──────────────────────────────────────────────────────────────────
# inline: BullMQ workers run inside the API process (default for dev)
# separate: run `pnpm --filter @masalim/api dev:worker` alongside the API
WORKER_MODE=inline
FFMPEG_PATH=
# Chromium binary for the print-PDF worker (empty = ffmpeg-static-style auto-detect:
# /opt/pw-browsers/chromium if present, else playwright-core's own browsers)
CHROMIUM_PATH=

# ── Mobile (Expo reads EXPO_PUBLIC_* at build time; set in apps/mobile/.env) ─
EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_PURCHASES_PROVIDER=mock
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# ── Admin ────────────────────────────────────────────────────────────────────
ADMIN_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
